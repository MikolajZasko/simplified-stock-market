<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">

    <title>Amplified Stonks Market | {{title}}</title>

    {{!-- favicon --}}
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    {{!-- bootstrap --}}
    <link rel="stylesheet" href="/scss/main.css">

    {{!-- bootstrap icons --}}
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">

    {{!-- helper css --}}
    <link rel="stylesheet" href="/css/main.css">

    {{!-- helper js --}}
    <script type="module" src="/js/main.js"></script>

</head>

<body class="d-flex flex-column min-vh-100">

    <div id="loading-overlay" class="bg-secondary">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    {{!-- error_overlay --}}
    <div id="error_overlay" class="d-none"></div>

    {{!-- error_box --}}
    <div id="error_box" class="alert alert-danger fade show absolute-center p-4 d-none shadow-lg"
        style="min-width: 350px;" role="alert">
        <div class="row g-0 align-items-start">

            {{!-- icon --}}
            <div class="col-auto me-3 mt-1">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-2"></i>
            </div>

            {{!-- message content --}}
            <div class="col">
                <h5 class="alert-heading text-danger fw-bold mb-1">Operation Failed</h5>
                <p id="error_message" class="text-dark mb-0 small">
                </p>
            </div>

            {{!-- close button --}}
            <div class="col-auto ms-2">
                <button type="button" class="btn-close bg-danger" aria-label="Close" id="error_close_button"></button>
            </div>
        </div>
    </div>

    <nav class="navbar justify-content-center border-bottom bs bg-primary sticky-top">
        {{#each nav_buttons}}
        <button type="button" class="btn btn-secondary m-2 nav_button"><a href="{{link}}"
                class="nav-link px-3">{{title}}</a></button>
        {{/each}}
    </nav>

    <main class="flex-grow-1 bg-custom_1 py-3">
        <div class="container ">
            <div class="row justify-content-center ">
                <div class="col-12 col-md-8 col-lg-6 shadow-sm p-5 rounded bg-secondary">
                    {{{body}}}
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-primary text-light py-5">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
                <p class="mb-0">&copy; 2026 Mikołaj Zaśko All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>